{
  "schemaVersion": 1,
  "startScreen": "title",
  "screens": [
    {
      "id": "title",
      "title": "Liminal Hall",
      "background": {
        "tint": [0.04, 0.05, 0.10, 0.98]
      },
      "blocks": [
        { "type": "heading", "text": "Liminal Hall", "align": "center" },
        { "type": "spacer", "height": 24 },
        { "type": "paragraph", "text": "Game-local UI flow. Author screens here inside the game folder.", "align": "center" },
        { "type": "spacer", "height": 32 },
        { "type": "button", "label": "Play", "action": { "type": "emit", "id": "game.start" } },
        { "type": "button", "label": "Story", "action": { "type": "navigate", "target": "story_intro" } },
        { "type": "button", "label": "Quit", "action": { "type": "emit", "id": "app.quit" } }
      ]
    },
    {
      "id": "story_intro",
      "title": "Story intro",
      "background": {
        "tint": [0.06, 0.04, 0.08, 0.96]
