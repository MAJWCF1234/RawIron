      "blocks": [
        { "type": "historyNote", "text": "Act I", "backlogOnly": true },
        { "type": "say", "speaker": "Guide", "text": "This screen lives in Games/LiminalHall/ui/main.ui.json." },
        { "type": "spacer", "height": 16 },
        { "type": "narration", "text": "Use the RawIron editor UI / VN workbench to preview and iterate on this flow.", "align": "left" },
        { "type": "spacer", "height": 20 },
        { "type": "label", "text": "Space or click to return", "align": "center" }
      ]
    }
  ]
}
