{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "dev-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "RAWIRON_BUILD_TESTS": "ON",
        "RAWIRON_BUILD_TOOLS": "ON"
      }
    },
    {
      "name": "dev-msvc",
      "inherits": "dev-base",
      "displayName": "Development (MSVC)",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "dev-msvc-localappdata",
      "inherits": "dev-msvc",
      "displayName": "Development (MSVC, binary dir under %LOCALAPPDATA%)",
      "binaryDir": "$env{LOCALAPPDATA}/RawIron/cmake-build/dev-msvc"
    },
    {
      "name": "dev-msvc-sanitized",
      "inherits": "dev-msvc",
      "displayName": "Development (MSVC AddressSanitizer)",
      "binaryDir": "${sourceDir}/build/dev-msvc-sanitized",
      "cacheVariables": {
        "RAWIRON_ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "dev-msvc-network",
      "inherits": "dev-msvc",
      "displayName": "Development (MSVC, ENet + EOS network lane)",
      "binaryDir": "${sourceDir}/build/dev-msvc-network",
      "cacheVariables": {
        "RAWIRON_USE_ENET": "ON",
        "RAWIRON_USE_EOS": "ON",
        "RAWIRON_BUILD_PLAYER": "OFF",
        "RAWIRON_BUILD_PREVIEW": "OFF",
        "RAWIRON_BUILD_EDITOR": "OFF",
        "RAWIRON_BUILD_FORGE": "OFF",
        "RAWIRON_BUILD_PARTICLE_SHOWCASE": "OFF",
        "RAWIRON_BUILD_LIMINAL_GAME": "OFF",
        "RAWIRON_BUILD_FOREST_RUINS_GAME": "OFF",
        "RAWIRON_BUILD_MULTIPLAYER_SANDBOX_GAME": "ON",
        "RAWIRON_BUILD_CUBE_TEST_GAME": "OFF",
        "RAWIRON_BUILD_VISUAL_SHELL": "OFF",
        "RAWIRON_BUILD_TOOLS": "OFF"
      }
    },
    {
      "name": "dev-clang",
      "inherits": "dev-base",
      "displayName": "Development (Clang)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "C:/Program Files/LLVM/bin/clang.exe",
        "CMAKE_CXX_COMPILER": "C:/Program Files/LLVM/bin/clang++.exe"
      }
    },
    {
      "name": "dev-mingw",
      "inherits": "dev-base",
      "displayName": "Development (MinGW, set CC/CXX on PATH)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "$penv{CC}",
        "CMAKE_CXX_COMPILER": "$penv{CXX}"
      }
    },
    {
      "name": "dev-linux-clang",
      "inherits": "dev-base",
      "displayName": "Development (Linux Clang)",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build-dev-msvc",
      "configurePreset": "dev-msvc",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "build-dev-msvc-localappdata",
      "configurePreset": "dev-msvc-localappdata",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "build-dev-msvc-sanitized",
      "configurePreset": "dev-msvc-sanitized",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "build-dev-msvc-network",
      "configurePreset": "dev-msvc-network",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "build-dev-clang",
      "configurePreset": "dev-clang"
    },
    {
      "name": "build-dev-mingw",
      "configurePreset": "dev-mingw"
    },
    {
      "name": "build-dev-linux-clang",
      "configurePreset": "dev-linux-clang"
    }
  ]
}
